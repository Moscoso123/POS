# Environment Variables - Copy to .env and fill with production values
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=7d

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=pos_system

# CORS Configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# API Configuration
API_PORT=3000
API_HOST=localhost

# Email Configuration (Gmail)
# Generate app-specific password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# AI Assistant Configuration
# Set OPENAI_API_KEY to enable live AI API responses in the in-app assistant.
# Without this key, the assistant uses the built-in local fallback logic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
